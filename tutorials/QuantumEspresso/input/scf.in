! SYSTEM = Bulk Silicon - Self Consistent calculation
! Get the converged charge density for non-SCF calculation
! in the next step

&control
    title = 'Silicon Supercell SCF'
    calculation = 'scf'
    restart_mode = 'from_scratch' ! restart_mode='restart' if calculation crrashes and need to restart
    prefix = 'bulk_Si'       ! Output files will have this prefix
    pseudo_dir = './pseudo/'   ! Directory where pseudopotentials are stored
    outdir = './'
    disk_io = 'low'
    nstep = 50
    wfcdir = './tmp/'
/
&system
    !smearing = 'marzari-vanderbilt'
    occupations = 'tetrahedra'
    lspinorb = .false.
    noncolin = .false.
    ibrav = 1
    A = 5.43
    nat = 8
    ntyp = 1
    ecutwfc = 18.03
    ecutrho = 100
    nbnd = 30
/
&electrons
    conv_thr = 1.0D-6   ! Convergence threshold
    mixing_beta = 0.7   ! Mixing factor for electron density
/
ATOMIC_SPECIES
  Si  28.0855  Si.pbe-rrkj.UPF ! Silicon pseudopotential

